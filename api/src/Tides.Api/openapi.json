      "get": {
        "tags": [
          "Stations"
        ],
        "summary": "Lists Kartverket's permanent tide stations.",
        "operationId": "GetStations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StationsResponse"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/stations/{code}/tides": {
      "get": {
        "tags": [
          "Tides"
        ],
        "summary": "Returns high and low tides for a range of UTC days for a specified station. Defaults to today and tomorrow.",
        "operationId": "GetStationTides",
